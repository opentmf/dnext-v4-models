      <module>dnext-customer-v4-model</module>
      <module>dnext-general-v4-model</module>
      <module>dnext-partner-v4-model</module>
      <module>dnext-product-v4-model</module>
      <module>dnext-resource-v4-model</module>
      <module>dnext-service-v4-model</module>
  </modules>
  <packaging>pom</packaging>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <java.version>17</java.version>
    <maven.compiler.source>${java.version}</maven.compiler.source>
    <maven.compiler.target>${java.version}</maven.compiler.target>

    <spring-boot.version>4.0.6</spring-boot.version>
    <opentmf-commons.version>2.2.0</opentmf-commons.version>

    <maven-compiler-plugin.version>3.15.0</maven-compiler-plugin.version>
    <maven-resources-plugin.version>3.5.0</maven-resources-plugin.version>
    <maven-deploy-plugin.version>3.1.4</maven-deploy-plugin.version>

    <maven-enforcer-plugin.version>3.6.2</maven-enforcer-plugin.version>
    <maven-release-plugin.version>3.3.1</maven-release-plugin.version>

    <maven-source-plugin.version>3.4.0</maven-source-plugin.version>
    <maven-javadoc-plugin.version>3.12.0</maven-javadoc-plugin.version>
    <maven-gpg-plugin.version>3.2.8</maven-gpg-plugin.version>
    <central-publishing-maven-plugin.version>0.10.0</central-publishing-maven-plugin.version>

    <!-- Reference-project artifact versions; tracked via property so that
         `mvn versions:display-property-updates` can flag upstream releases. -->
    <opentmf-620-v4-api.version>4.1.0.11</opentmf-620-v4-api.version>
    <opentmf-622-v4-api.version>4.0.0.11</opentmf-622-v4-api.version>
    <opentmf-629-v4-api.version>4.0.0.11</opentmf-629-v4-api.version>
